# Copy this file to .env and replace every placeholder before starting Docker Compose.
# Never commit the copied .env file.

# Backend database settings
DB_NAME=pstracker
DB_USERNAME=pstracker_user
DB_PASSWORD=replace-with-a-strong-local-password
DB_URL=jdbc:postgresql://localhost:5433/pstracker
DOCKER_DB_URL=jdbc:postgresql://postgres:5432/pstracker

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters

# AWS S3 storage
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=replace-with-your-bucket-name

# Backend integrations and deployment URLs
CODEFORCES_BASE_URL=https://codeforces.com/api
SWAGGER_SERVER_URL=http://localhost:8080
TRUSTED_PROXY_ADDRESSES=

# CORS origins
FRONTEND_ORIGIN_1=http://localhost:5173
FRONTEND_ORIGIN_2=http://localhost:5174
FRONTEND_ORIGIN_3=http://127.0.0.1:5173
FRONTEND_ORIGIN_4=http://127.0.0.1:5174
FRONTEND_ORIGIN_5=

# Grafana local login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
